{
  "name": "nova-startup",
  "private": true,
  "description": "Atalhos para rodar o app tem-agua a partir da raiz",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "npm run dev --prefix tem-agua",
    "dev:ngrok": "npm run dev:ngrok --prefix tem-agua",
    "dev:tunnel": "npm run dev:tunnel --prefix tem-agua",
    "stop": "npm run stop --prefix tem-agua",
    "docker:up": "docker compose up -d --build",
    "docker:ngrok": "docker compose --profile ngrok up -d --build",
    "docker:tunnel": "docker compose --profile cloudflared up -d --build",
    "docker:logs": "docker compose --profile ngrok --profile cloudflared logs -f",
    "docker:down": "docker compose --profile ngrok --profile cloudflared down",
    "abastecimento:importar": "npm run abastecimento:importar --prefix tem-agua",
    "db:psql": "docker compose exec db psql -U temagua -d temagua"
  }
}
